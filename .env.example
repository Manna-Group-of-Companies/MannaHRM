# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real key here.
#
# Where the key comes from: Desk -> User -> integration@mannarubber.com ->
# API Access -> Generate Keys. The secret is shown once, at that moment, and
# never again — generating a new pair invalidates the old one, so do not press
# it to "check" a key the bridge is already running on. See docs/SETUP.md §0.
#
# What this key can do: read and write the whole site, including attendance,
# which is payroll (CLAUDE.md §1). It belongs on the machines that run the
# proxy and the bridge, and nowhere else. It never reaches the browser —
# app/serve.js attaches it on the way out and the page never sees it.

ERP_URL=https://mannarubber.m.frappe.cloud
ERP_KEY=
ERP_SECRET=


# Off by default. Set to 1 to let the dashboard write an approval decision back
# to the site — one PUT, three doctypes, two fields, and the rule still runs on
# the site rather than here. See app/serve.js.
# ERP_WRITE=1

# The bridge reads the same site under these names. Set them to the same pair if
# this machine also runs the fingerprint bridge; the dashboard accepts either
# spelling, so one file serves both.
# MANNA_API_KEY=
# MANNA_API_SECRET=
