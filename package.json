{
  "name": "manna-hrm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Group-wide attendance and HR website for the Manna companies — React, Vite, Tailwind",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "build": "vite build client",
    "preview": "vite preview client",
    "start": "node server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "bridge": "node bridge/mannabridge/main.js",
    "bridge:once": "node bridge/mannabridge/main.js --once",
    "probe": "node bridge/probe.js",
    "install:all": "npm install && npm --prefix bridge install && npm --prefix tools install"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
