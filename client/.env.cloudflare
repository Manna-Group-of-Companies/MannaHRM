# What `npm run build:cloudflare` uses, on top of `.env`.
#
# Tracked, like `.env.production`, because none of it is a secret — and because
# the Cloudflare build has no `.env` at all, so this file is the whole of what
# it knows. See client/README.md.

# Served at the root of its own hostname, so no mount.
VITE_ROUTE_BASE=

# The desk is on the site, not on this origin. The Worker forwards `/app` and
# `/desk` only so `fetchCsrf` can read a token out of them; it does not forward the desk's own
# `/assets`, so a desk opened through it would draw unstyled. Links go straight
# to the site, where the person signs in a second time — the session here
# belongs to this hostname and the site cannot see it.
VITE_DESK_URL=https://mannarubber.m.frappe.cloud
