# Manna HR — the client. Copy to `.env`.
#
# ERPNext is the server. There is no process of ours in between, so both of
# these are about the *site*: one names it for the dev proxy, the other names it
# for the links that open a form on the desk.

# The site this app talks to. Read at build time by vite.config.js for the dev
# proxy only — Vite makes `/api`, `/app`, `/files` and `/private` on :5173 look
# like this host, which is what gives the browser one origin and lets it keep
# the session cookie. Not exposed to the bundle: it has no VITE_ prefix.
ERP_URL=https://mannarubber.m.frappe.cloud

# Where New / Edit / Delete / Data Import send somebody — a Frappe desk.
#
# This one *is* in the bundle, and that is fine: it is a URL a person clicks,
# not an address this app calls. Leave it unset in production, where the site
# serves this page and the desk is the same origin. Set it to `-` to disable
# those controls outright; they then sit disabled with the reason on them,
# which is the honest state when there is nowhere to send anybody.
VITE_DESK_URL=https://mannarubber.m.frappe.cloud
