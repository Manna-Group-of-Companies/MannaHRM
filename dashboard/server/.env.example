# The API's own port. The client's Vite dev server proxies /api here — see
# client/vite.config.js, which reads MANNA_PROXY_PORT for the same number.
PORT=8770

# Where the data lives. A local mongod, or an Atlas SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/manna_hrm

# The Frappe/ERPNext desk this dashboard links out to on GET /api/site — New,
# Edit, Delete and Data Import, on every screen that can only read here. Empty
# leaves those controls disabled with the reason on them, which is the honest
# state when there is nowhere to go.
#
# **It has to be a real desk, not this server.** This file used to suggest
# http://localhost:8770, which is the API itself: the client builds
# <SITE_URL>/app/holiday-list/new out of it, this server answers any path it
# does not recognise with the client bundle, and every one of those buttons
# opens a new tab containing the dashboard again — a button that appears to do
# nothing. /api/site now drops a value naming this server rather than passing it
# on, and says so as `urlIgnored`.
SITE_URL=https://your-site.frappe.cloud

# Writes are off unless this is exactly "1".
#
# This is the same switch the ERPNext proxy had and it is kept for the same
# reason: the default run of this server is a read-only one, so a dashboard
# opened to look at something cannot change it. Turning it on enables exactly
# three things — the allowlisted PUT, the allowlisted POST, and nothing else.
# See src/doctypes/registry.ts.
ERP_WRITE=0

# Origins allowed to call the API cross-origin. Empty means same-origin only,
# which is what production is: this process serves the built client itself.
# In development Vite proxies, so the browser still sees one origin and this
# stays empty there too.
CORS_ORIGIN=

# Where the built client lives, relative to the repo root. The server serves it
# in production; if the directory is not there, the API still runs.
CLIENT_DIST=dist

# Where the bytes behind a `File` row live, relative to the repo root — the
# document scans the On Board Document register's paperclip opens. Outside
# `dist/` on purpose: that directory is wiped by every build, and a passport
# scan that disappears when somebody rebuilds the front end is one nobody can
# rely on. Created by `npm run seed`; served, read-only, at /files.
FILES_DIR=files

# Creating the doctypes on the ERPNext site — `npm run erpnext:push`. Only that
# one script reads these; the API server never does, and never talks to the
# Frappe site itself. SITE_URL above is used if ERPNEXT_URL is empty.
#
# The pair comes from the desk: User -> API Access -> Generate Keys, on a user
# holding System Manager. Nothing less can create a doctype. Leave them empty
# and the push refuses to run, which is the right state for a checkout that has
# no business writing to the site.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
