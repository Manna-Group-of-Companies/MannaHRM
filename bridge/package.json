{
  "name": "mannabridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reads the fingerprint machines on the Manna LAN and posts punches to ERPNext",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node mannabridge/main.js",
    "once": "node mannabridge/main.js --once",
    "probe": "node probe.js",
    "check-push": "node check-push.js",
    "test": "node --test mannabridge/*.test.js"
  },
  "dependencies": {
    "node-zklib": "1.3.0",
    "smol-toml": "1.8.0"
  }
}
