# Holds an API key that can write attendance for the whole group.
bridge/config.toml

# The same key, for the dashboard proxy. `.env.example` is the tracked one and
# is deliberately empty — a committed key is a key that has to be rotated.
.env
.env.local

# Factor HR exports — salary, PAN, Aadhaar, bank details for the whole group.
# Never commit these. The directory is tracked; its contents are not.
# Git will not descend into an excluded directory, so directories have to be
# re-included before a file inside one can be.
data/**
!data/**/
!data/**/README.md

# Node: installed packages, the built site, and the bridge's working files.
node_modules/
dist/
bridge/*.sqlite3
bridge/*.sqlite3-wal
bridge/*.sqlite3-shm
bridge/*.log
bridge/bridge.log
